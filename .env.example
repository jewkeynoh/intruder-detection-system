# Environment variables for Intruder Alert System
# Copy this file to .env and fill in your actual credentials.
# IMPORTANT: Add .env to your .gitignore file! DO NOT COMMIT YOUR SECRETS!

# --- Email (Gmail Example) ---
# Generate an App Password if using 2FA: https://myaccount.google.com/apppasswords
GMAIL_APP_PASSWORD=your_16_digit_gmail_app_password

# --- SMS (Twilio Example) ---
# Get from your Twilio Console: https://www.twilio.com/console
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token

# --- App Notification (Pushover Example) ---
# Get from Pushover website after registering: https://pushover.net/
PUSHOVER_API_TOKEN=your_pushover_application_api_token
PUSHOVER_USER_KEY=your_pushover_user_key

# --- App Notification (ntfy.sh Example) ---
# No credentials needed by default for public server, just the topic in config.py
# If using authentication on a private server, add relevant variables here.